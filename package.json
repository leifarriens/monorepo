{
  "name": "@la/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "No Frameworks included Typescript Monorepo Template with Linter, Tests & CI",
  "license": "MIT",
  "author": "Leif Arriens",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "format": "oxfmt",
    "build": "turbo build --continue",
    "lint": "turbo lint --continue",
    "lint:fix": "turbo lint --continue -- --fix",
    "postinstall": "sherif",
    "lint:ws": "sherif",
    "test": "turbo test",
    "typecheck": "turbo typecheck --continue",
    "turbo": "turbo"
  },
  "devDependencies": {
    "@turbo/gen": "^2.11.4",
    "@types/node": "^24.13.3",
    "oxfmt": "^0.72.0",
    "sherif": "^1.13.0",
    "turbo": "^2.11.4"
  },
  "packageManager": "pnpm@12.9.1",
  "sherif": {
    "ignoreRule": [
      "non-existant-packages"
    ]
  }
}
