{
  "name": "@la/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node ./node_modules/typescript-7/bin/tsc --build tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "node ./node_modules/typescript-7/bin/tsc --watch --project tsconfig.build.json",
    "lint": "eslint --cache --cache-location .cache/.eslintcache",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit"
  },
  "dependencies": {
    "@la/core": "workspace:*",
    "@la/lib": "workspace:*"
  },
  "devDependencies": {
    "@la/eslint-config": "workspace:*",
    "@la/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  }
}
