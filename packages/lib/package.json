{
  "name": "@la/lib",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ./node_modules/typescript-7/bin/tsc --build tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "node ./node_modules/typescript-7/bin/tsc --watch --project tsconfig.build.json",
    "lint": "eslint --cache --cache-location .cache/.eslintcache",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@la/eslint-config": "workspace:*",
    "@la/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  }
}
