{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranches": ["main", "next"],
  "automerge": true,
  "ignorePaths": ["**/node_modules/**"],
  "schedule": ["every weekend"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Batch common JavaScript tooling updates into a smaller number of PRs.",
      "matchPackageNames": [
        "/^@types\\//",
        "/^eslint/",
        "/^@eslint\\//",
        "/^prettier$/",
        "/^typescript$/",
        "/^vitest$/",
        "/^turbo$/",
        "/^sherif$/"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "tooling dependencies"
    },
    {
      "description": "Keep Next.js and its ESLint config on the same version.",
      "matchPackageNames": ["next", "eslint-config-next"],
      "groupName": "Next.js dependencies"
    },
    {
      "description": "Group updates for better-auth and auth packages.",
      "matchPackageNames": ["/better-auth/", "auth"],
      "groupName": "auth dependencies"
    }
  ]
}
